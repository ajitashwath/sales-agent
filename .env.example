# Copy this file to .env and fill in your keys.

# --- Deepgram (streaming speech-to-text) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# 16000 mono linear16 PCM is what scripts/test_client.py streams.
AUDIO_SAMPLE_RATE=16000

# --- Google Gemini (conversational brain + summaries) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4

# --- ElevenLabs (streaming text-to-speech) ---
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs account. Default below is "Sarah", a
# premade voice that works on ElevenLabs free plans (library voices need a
# paid plan and return HTTP 402).
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# pcm_16000 = raw 16-bit PCM 16 kHz (easy for the test client).
# Use mp3_44100_128 for a browser client that decodes MP3.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# --- Google Calendar ---
# Path to the service-account JSON (relative to the project root is fine).
# If this file is missing, availability and booking fall back to mocks.
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/google-service-account.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
# Optional: Workspace user to impersonate (needs domain-wide delegation).
GOOGLE_CALENDAR_DELEGATED_USER=

# --- Persona used in the system prompt ---
COMPANY_NAME=StockPilot
COMPANY_PRODUCT=cloud-based inventory software for small retailers

# --- Storage ---
DATABASE_URL=sqlite:///sales_agent.db
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=sales_knowledge_base
